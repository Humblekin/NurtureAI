# NurtureAI Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenRouter AI Configuration (for Amina chat)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here

# ElevenLabs Text-to-Speech (optional, for natural voice)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# App Configuration
VITE_APP_NAME=NurtureAI
VITE_APP_VERSION=1.0.0
