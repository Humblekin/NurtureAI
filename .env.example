# NurtureAI Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Groq AI Configuration (for Amina chat)
VITE_GROQ_API_KEY=your-groq-api-key-here

# ElevenLabs Text-to-Speech (deprecated — now using Deepgram)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Deepgram Voice Configuration (required for voice features)
VITE_DEEPGRAM_API_KEY=your-deepgram-api-key-here

# App Configuration
VITE_APP_NAME=NurtureAI
VITE_APP_VERSION=1.0.0
