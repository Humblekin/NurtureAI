# NurtureAI Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=NurtureAI
VITE_APP_VERSION=1.0.0

# Khaya AI (African-language speech ASR/TTS) — SERVER-SIDE SECRET ONLY.
# It is read by the `khaya` Supabase Edge Function and must NEVER be placed in
# a VITE_* variable, committed to git, or sent to the browser. Set it with:
#   npx supabase secrets set KHAYA_API_KEY=your-key
# (an `.env.local` / `supabase/.env` file may be used locally for `supabase
# functions serve`, but never commit the real key).
# KHAYA_API_KEY=
